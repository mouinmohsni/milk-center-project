# =====================================================
# Collection Service
# =====================================================

# Nom de l'application
spring.application.name=collection-service

# =====================================================
# Serveur HTTP
# =====================================================

# En local : 8082
# Dans Docker Compose : SERVER_PORT=8082
server.port=${SERVER_PORT:8082}


# =====================================================
# Base de données MySQL
# =====================================================

# En local : localhost et milk_collection_db.
# Dans Docker Compose, cette valeur sera remplacée par une URL
# utilisant le nom du service Docker : collection-db.
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:mysql://localhost:3306/milk_collection_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:*****}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:*****}

# =====================================================
# JPA / Hibernate
# =====================================================

spring.jpa.hibernate.ddl-auto=${SPRING_JPA_HIBERNATE_DDL_AUTO:update}
spring.jpa.show-sql=${SPRING_JPA_SHOW_SQL:true}
spring.jpa.properties.hibernate.dialect=${SPRING_JPA_DIALECT:org.hibernate.dialect.MySQLDialect}

# =====================================================
# Eureka Discovery Server
# =====================================================

# En local : http://localhost:8761/eureka/
# Dans Docker Compose : http://discovery-server:8761/eureka/
eureka.client.service-url.defaultZone=${EUREKA_CLIENT_SERVICEURL_DEFAULTZONE:http://localhost:8761/eureka/}
eureka.client.register-with-eureka=${EUREKA_CLIENT_REGISTER_WITH_EUREKA:true}
eureka.client.fetch-registry=${EUREKA_CLIENT_FETCH_REGISTRY:true}

eureka.instance.hostname=${EUREKA_INSTANCE_HOSTNAME:localhost}
eureka.instance.prefer-ip-address=${EUREKA_INSTANCE_PREFER_IP_ADDRESS:false}

# =====================================================
# Gestion des erreurs
# =====================================================

server.error.include-message=${SERVER_ERROR_INCLUDE_MESSAGE:always}

# =====================================================
# Resilience4j - Circuit Breaker pour fleet-service
# =====================================================

resilience4j.circuitbreaker.instances.fleetservice.register-health-indicator=true
resilience4j.circuitbreaker.instances.fleetService.sliding-window-type=COUNT_BASED
resilience4j.circuitbreaker.instances.fleetService.sliding-window-size=5
resilience4j.circuitbreaker.instances.fleetService.minimum-number-of-calls=3
resilience4j.circuitbreaker.instances.fleetService.failure-rate-threshold=50
resilience4j.circuitbreaker.instances.fleetService.wait-duration-in-open-state=10s
resilience4j.circuitbreaker.instances.fleetService.permitted-number-of-calls-in-half-open-state=2
resilience4j.circuitbreaker.instances.fleetService.automatic-transition-from-open-to-half-open-enabled=true

# Délai maximal d’un appel Feign vers fleet-service
spring.cloud.openfeign.client.config.fleet-service.connect-timeout=2000
spring.cloud.openfeign.client.config.fleet-service.read-timeout=3000


# =====================================================
# OAuth2 Resource Server - validation des tokens reçus
# =====================================================
spring.security.oauth2.resourceserver.jwt.issuer-uri=${OAUTH2_ISSUER_URI:http://localhost:8080/realms/milkcenter}

# =====================================================
# OAuth2 Client - appels sortants de collection-service
# =====================================================

spring.security.oauth2.client.registration.service-client.provider=keycloak
spring.security.oauth2.client.registration.service-client.client-id=${OAUTH2_CLIENT_ID:milkcenter-collection-service}
spring.security.oauth2.client.registration.service-client.client-secret=${OAUTH2_CLIENT_SECRET:***************}
spring.security.oauth2.client.registration.service-client.authorization-grant-type=client_credentials
spring.security.oauth2.client.registration.service-client.scope=milkcenter.read

spring.security.oauth2.client.provider.keycloak.token-uri=${OAUTH2_TOKEN_URI:http://localhost:8080/realms/milkcenter/protocol/openid-connect/token}

# =====================================================
# OAuth2 pour OpenFeign
# =====================================================

spring.cloud.openfeign.oauth2.enabled=false
spring.cloud.openfeign.oauth2.client-registration-id=service-client


# =====================================================
# Kafka Producer
# =====================================================
spring.kafka.bootstrap-servers=${KAFKA_BOOTSTRAP_SERVERS:localhost:9092}
spring.kafka.producer.key-serializer=org.apache.kafka.common.serialization.StringSerializer
spring.kafka.producer.value-serializer=org.springframework.kafka.support.serializer.JsonSerializer

# Évite l’ajout de métadonnées de type Java dans le JSON Kafka
spring.kafka.producer.properties[spring.json.add.type.headers]=false


# =====================================================
# debug
# =====================================================
logging.level.org.milkcenter.collectionservice.client=DEBUG
logging.level.org.springframework.cloud.openfeign=DEBUG
logging.level.feign=DEBUG
