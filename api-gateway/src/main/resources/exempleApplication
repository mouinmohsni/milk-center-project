spring:
  application:
    name: api-gateway

  cloud:
    gateway:
      routes:
        # ================================
        # Identity Service
        # ================================
        - id: identity-service
          uri: lb://identity-service
          predicates:
            - Path=/api/auth/**,/api/users/**

        # ================================
        # Collection Service
        # ================================
        - id: collection-service
          uri: lb://collection-service
          predicates:
            - Path=/api/farmers/**,/api/collections/**
          filters:
            - AuthenticationFilter

        # ================================
        # Fleet Service
        # ================================
        - id: fleet-service
          uri: lb://fleet-service
          predicates:
            - Path=/api/drivers/**,/api/vehicles/**,/api/routes/**,/api/route-stops/**,/api/route-executions/**
          filters:
            - AuthenticationFilter

        # ================================
        # Invoicing Service
        # ================================
        - id: invoicing-service
          uri: lb://invoicing-service
          predicates:
            - Path=/api/invoices/**,/api/payments/**,/api/pricing-configurations/**
          filters:
            - AuthenticationFilter

# ========================================
# Eureka Client
# ========================================
eureka:
  client:
    service-url:
      defaultZone: "${EUREKA_CLIENT_SERVICEURL_DEFAULTZONE:http://localhost:8761/eureka/}"
    register-with-eureka: "${EUREKA_CLIENT_REGISTER_WITH_EUREKA:true}"
    fetch-registry: "${EUREKA_CLIENT_FETCH_REGISTRY:true}"
  instance:
    hostname: "${EUREKA_INSTANCE_HOSTNAME:localhost}"
    prefer-ip-address: "${EUREKA_INSTANCE_PREFER_IP_ADDRESS:false}"

# ========================================
# Serveur Gateway
# ========================================
server:
  port: ${SERVER_PORT:9000}

# ========================================
# JWT utilisé par AuthenticationFilter
# ========================================
jwt:
  secret: "${JWT_SECRET:*****************************************************}"
