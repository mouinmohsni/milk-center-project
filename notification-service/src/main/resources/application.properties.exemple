spring.application.name=notification-service
server.port=${SERVER_PORT:8085}

spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/milk_notification_db?createDatabaseIfNotExist=true&serverTimezone=Africa/Tunis}
spring.datasource.username=${DB_USERNAME:*******}
spring.datasource.password=${DB_PASSWORD:*******}
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false

spring.kafka.bootstrap-servers=${KAFKA_BOOTSTRAP_SERVERS:localhost:9092}
spring.kafka.consumer.group-id=notification-service-group
spring.kafka.consumer.auto-offset-reset=earliest
spring.kafka.consumer.enable-auto-commit=false
spring.kafka.listener.ack-mode=record
spring.kafka.consumer.key-deserializer=org.apache.kafka.common.serialization.StringDeserializer
spring.kafka.consumer.value-deserializer=org.apache.kafka.common.serialization.StringDeserializer

app.kafka.topics.invoice-created=invoice-notification-events
app.kafka.topics.invoice-line-added=invoice-line-notification-events
app.kafka.topics.invoice-reminder=invoice-processing-reminder-events
app.kafka.topics.invoice-processed=invoice-processed-events
app.kafka.topics.invoice-cancelled=invoice-cancelled-events
app.kafka.topics.collection-events=milk-collection-events

spring.security.oauth2.resourceserver.jwt.issuer-uri=${OAUTH2_ISSUER_URI:http://localhost:8080/realms/milkcenter}
eureka.client.service-url.defaultZone=${EUREKA_URL:http://localhost:8761/eureka/}
eureka.client.register-with-eureka=true
eureka.client.fetch-registry=true
management.endpoints.web.exposure.include=health,info
